        if(g.size!=sizeof(d)||g.pipeline>9||!transparency.glass[g.pipeline].handle||g.object_bytes!=transparency.glass[g.pipeline].object_bytes||!g.object_constants||!g.instance_count||g.instance_count>1000000||!world.meshes.count(g.mesh)||!textures.count(g.color)||!textures.count(g.normal))throw std::runtime_error("invalid glass draw/resources/constants");
