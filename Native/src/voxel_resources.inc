VkFormat voxel_format(uint32_t f,bool s){static const VkFormat a[]{VK_FORMAT_R8G8B8A8_UNORM,VK_FORMAT_B8G8R8A8_UNORM,VK_FORMAT_BC1_RGBA_UNORM_BLOCK,VK_FORMAT_BC2_UNORM_BLOCK,VK_FORMAT_BC3_UNORM_BLOCK,VK_FORMAT_BC4_UNORM_BLOCK,VK_FORMAT_BC5_UNORM_BLOCK,VK_FORMAT_BC6H_UFLOAT_BLOCK,VK_FORMAT_BC7_UNORM_BLOCK};static const VkFormat b[]{VK_FORMAT_R8G8B8A8_SRGB,VK_FORMAT_B8G8R8A8_SRGB,VK_FORMAT_BC1_RGBA_SRGB_BLOCK,VK_FORMAT_BC2_SRGB_BLOCK,VK_FORMAT_BC3_SRGB_BLOCK,VK_FORMAT_BC4_UNORM_BLOCK,VK_FORMAT_BC5_UNORM_BLOCK,VK_FORMAT_BC6H_UFLOAT_BLOCK,VK_FORMAT_BC7_SRGB_BLOCK};return s?b[f]:a[f];}
// Immutable material groups and array images. Replacements retire on the same
// reserved upload/graphics timeline as other world resources.
void upload_voxel_array(uint64_t id,uint32_t width,uint32_t height,uint32_t format,bool srgb,uint32_t layers,uint32_t mips,const void* data,uint64_t bytes){
    if(recording || !id || !data || !width || !height || width>16384 || height>16384 || !layers || layers>256 || !mips || mips>15 || format>8)throw std::runtime_error("invalid voxel array upload");
    uint32_t max_mips=1;for(uint32_t n=std::max(width,height);n>1;n>>=1)++max_mips;if(mips>max_mips)throw std::runtime_error("voxel mip count exceeds dimensions");
    uint64_t expected=0;std::vector<VkBufferImageCopy> copies;
    for(uint32_t layer=0;layer<layers;++layer)for(uint32_t mip=0;mip<mips;++mip){uint32_t w=std::max(1u,width>>mip),h=std::max(1u,height>>mip);VkBufferImageCopy c{};c.bufferOffset=expected;c.imageSubresource={VK_IMAGE_ASPECT_COLOR_BIT,mip,layer,1};c.imageExtent={w,h,1};copies.push_back(c);expected+=format<2?uint64_t(w)*h*4:uint64_t((w+3)/4)*((h+3)/4)*(format==2||format==5?8:16);}
    if(bytes!=expected || bytes>512ull*1024*1024)throw std::runtime_error("voxel array byte count/budget mismatch");
    Image image{};Buffer staging{};try{image=make_image(width,height,voxel_format(format,srgb),VK_IMAGE_USAGE_TRANSFER_DST_BIT|VK_IMAGE_USAGE_SAMPLED_BIT,VK_IMAGE_ASPECT_COLOR_BIT,mips,layers,true);staging=make_buffer(bytes,VK_BUFFER_USAGE_TRANSFER_SRC_BIT,true);std::memcpy(staging.mapped,data,bytes);check(vmaFlushAllocation(allocator,staging.memory,0,bytes),"flush voxel array upload");
        immediate([&](VkCommandBuffer cmd){barrier(cmd,image.handle,VK_IMAGE_LAYOUT_UNDEFINED,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,VK_IMAGE_ASPECT_COLOR_BIT,VK_PIPELINE_STAGE_2_NONE,0,VK_PIPELINE_STAGE_2_TRANSFER_BIT,VK_ACCESS_2_TRANSFER_WRITE_BIT,mips,layers);vkCmdCopyBufferToImage(cmd,staging.handle,image.handle,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,uint32_t(copies.size()),copies.data());barrier(cmd,image.handle,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,VK_IMAGE_ASPECT_COLOR_BIT,VK_PIPELINE_STAGE_2_TRANSFER_BIT,VK_ACCESS_2_TRANSFER_WRITE_BIT,VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT,VK_ACCESS_2_SHADER_SAMPLED_READ_BIT,mips,layers);});destroy_buffer(staging);
        auto it=world.arrays.find(id);if(it!=world.arrays.end()){Texture t{};t.image=it->second;retired.push_back({next_completion,t,{}});it->second=image;recycle_cached_array(id);}else world.arrays.emplace(id,image);stats.uploaded_bytes+=bytes;
    }catch(...){if(batching_uploads){flush_uploads();wait(next_completion);}destroy_buffer(staging);destroy_image(image);throw;}
}
void set_voxel_material(uint64_t id,const void* constants,uint32_t bytes,const uint64_t* arrays,uint64_t random){
    if(recording || !id || !constants || bytes!=30720 || !arrays || (random && !textures.count(random)))throw std::runtime_error("invalid voxel material constants");for(uint32_t i=0;i<3;++i)if(!world.arrays.count(arrays[i]))throw std::runtime_error("missing voxel array");
    VoxelMaterial m{};m.constants=make_buffer(bytes,VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT,true);std::memcpy(m.constants.mapped,constants,bytes);try{check(vmaFlushAllocation(allocator,m.constants.memory,0,bytes),"flush voxel material constants");}catch(...){destroy_buffer(m.constants);throw;}std::copy(arrays,arrays+3,m.arrays);m.random=random;
    auto it=world.voxel_materials.find(id);if(it!=world.voxel_materials.end()){Mesh old{};old.vertices=it->second.constants;retired.push_back({next_completion,{},old});it->second=m;recycle_cached_voxel(id);}else world.voxel_materials.emplace(id,m);
}
void init_voxel_copy(){
    if(world.copy_layout)return;
    VkDescriptorSetLayoutBinding bindings[]{{0,VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,1,VK_SHADER_STAGE_FRAGMENT_BIT,nullptr},{1,VK_DESCRIPTOR_TYPE_SAMPLER,1,VK_SHADER_STAGE_FRAGMENT_BIT,nullptr}};
    VkDescriptorSetLayoutCreateInfo info{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};info.bindingCount=2;info.pBindings=bindings;check(vkCreateDescriptorSetLayout(device,&info,nullptr,&world.copy_layout),"create voxel normalization layout");world.copy_pipeline_layout=world_pipeline_layout(world.copy_layout);
    auto pixel=world_file_shader("voxel_copy_ps");try{for(uint32_t i=0;i<2;++i){VkFormat format=i?VK_FORMAT_R8G8B8A8_SRGB:VK_FORMAT_R8G8B8A8_UNORM;world.copy_pipelines[i]=world_graphics(world.fullscreen,"__vertex_shader",pixel,"main",world.copy_pipeline_layout,{{0,24,VK_VERTEX_INPUT_RATE_VERTEX}},world.fullscreen_attributes,&format,1,false);}vkDestroyShaderModule(device,pixel,nullptr);}catch(...){vkDestroyShaderModule(device,pixel,nullptr);throw;}
}
void build_voxel_array(uint64_t id,uint32_t size,bool srgb,const uint64_t* sources,uint32_t layers){
    if(recording||!id||!sources||!layers||layers>256||size<1||size>1024||!world.fullscreen)throw std::runtime_error("invalid normalized voxel array");for(uint32_t i=0;i<layers;++i)if(!textures.count(sources[i]))throw std::runtime_error("missing voxel normalization source");
    init_voxel_copy();uint32_t mips=1;for(uint32_t n=size;n>1;n>>=1)++mips;
    Image image{};AtlasTransient transient{};
    try{
        image=make_image(size,size,srgb?VK_FORMAT_R8G8B8A8_SRGB:VK_FORMAT_R8G8B8A8_UNORM,VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT|VK_IMAGE_USAGE_SAMPLED_BIT|VK_IMAGE_USAGE_TRANSFER_SRC_BIT|VK_IMAGE_USAGE_TRANSFER_DST_BIT,VK_IMAGE_ASPECT_COLOR_BIT,mips,layers,true);
        for(uint32_t i=0;i<layers;++i){VkImageViewCreateInfo v{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};v.image=image.handle;v.viewType=VK_IMAGE_VIEW_TYPE_2D;v.format=srgb?VK_FORMAT_R8G8B8A8_SRGB:VK_FORMAT_R8G8B8A8_UNORM;v.subresourceRange={VK_IMAGE_ASPECT_COLOR_BIT,0,1,i,1};VkImageView view{};check(vkCreateImageView(device,&v,nullptr,&view),"create voxel atlas layer view");transient.views.push_back(view);
            auto set=allocate_set(world.copy_layout);transient.sets.push_back(set);world_write_image(set,0,textures.at(sources[i]).image.view);world_write_image(set,1,{},sprite_sampler,true);}
        immediate([&](VkCommandBuffer cmd){
            barrier(cmd,image.handle,VK_IMAGE_LAYOUT_UNDEFINED,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,VK_IMAGE_ASPECT_COLOR_BIT,VK_PIPELINE_STAGE_2_NONE,0,VK_PIPELINE_STAGE_2_TRANSFER_BIT,VK_ACCESS_2_TRANSFER_WRITE_BIT,mips,layers);
            barrier(cmd,image.handle,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,VK_IMAGE_ASPECT_COLOR_BIT,VK_PIPELINE_STAGE_2_TRANSFER_BIT,VK_ACCESS_2_TRANSFER_WRITE_BIT,VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT,VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,1,layers);
            for(uint32_t i=0;i<layers;++i){VkRenderingAttachmentInfo a{VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};a.imageView=transient.views[i];a.imageLayout=VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;a.loadOp=VK_ATTACHMENT_LOAD_OP_DONT_CARE;a.storeOp=VK_ATTACHMENT_STORE_OP_STORE;VkRenderingInfo r{VK_STRUCTURE_TYPE_RENDERING_INFO};r.renderArea={{0,0},{size,size}};r.layerCount=1;r.colorAttachmentCount=1;r.pColorAttachments=&a;vkCmdBeginRendering(cmd,&r);vkCmdBindPipeline(cmd,VK_PIPELINE_BIND_POINT_GRAPHICS,world.copy_pipelines[srgb?1:0]);vkCmdBindDescriptorSets(cmd,VK_PIPELINE_BIND_POINT_GRAPHICS,world.copy_pipeline_layout,0,1,&transient.sets[i],0,nullptr);VkDeviceSize zero=0;vkCmdBindVertexBuffers(cmd,0,1,&world.quad.handle,&zero);world_viewport(cmd,size,size);vkCmdDraw(cmd,3,1,0,0);vkCmdEndRendering(cmd);}
            auto mip_barrier=[&](uint32_t mip,VkImageLayout old,VkImageLayout next,VkPipelineStageFlags2 stage,VkAccessFlags2 access){VkImageMemoryBarrier2 b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2};b.srcStageMask=stage;b.srcAccessMask=access;b.dstStageMask=VK_PIPELINE_STAGE_2_TRANSFER_BIT;b.dstAccessMask=VK_ACCESS_2_TRANSFER_READ_BIT;b.oldLayout=old;b.newLayout=next;b.srcQueueFamilyIndex=b.dstQueueFamilyIndex=VK_QUEUE_FAMILY_IGNORED;b.image=image.handle;b.subresourceRange={VK_IMAGE_ASPECT_COLOR_BIT,mip,1,0,layers};VkDependencyInfo d{VK_STRUCTURE_TYPE_DEPENDENCY_INFO};d.imageMemoryBarrierCount=1;d.pImageMemoryBarriers=&b;vkCmdPipelineBarrier2(cmd,&d);};
            mip_barrier(0,VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT,VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT);
            for(uint32_t mip=1;mip<mips;++mip){VkImageBlit blit{};blit.srcSubresource={VK_IMAGE_ASPECT_COLOR_BIT,mip-1,0,layers};blit.dstSubresource={VK_IMAGE_ASPECT_COLOR_BIT,mip,0,layers};blit.srcOffsets[1]={int32_t(std::max(1u,size>>(mip-1))),int32_t(std::max(1u,size>>(mip-1))),1};blit.dstOffsets[1]={int32_t(std::max(1u,size>>mip)),int32_t(std::max(1u,size>>mip)),1};vkCmdBlitImage(cmd,image.handle,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,image.handle,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,1,&blit,VK_FILTER_LINEAR);mip_barrier(mip,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,VK_PIPELINE_STAGE_2_TRANSFER_BIT,VK_ACCESS_2_TRANSFER_WRITE_BIT);}
            barrier(cmd,image.handle,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,VK_IMAGE_ASPECT_COLOR_BIT,VK_PIPELINE_STAGE_2_TRANSFER_BIT,VK_ACCESS_2_TRANSFER_READ_BIT|VK_ACCESS_2_TRANSFER_WRITE_BIT,VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT,VK_ACCESS_2_SHADER_SAMPLED_READ_BIT,mips,layers);
        });
        transient.completion=next_completion;world.atlas_transients.push_back(std::move(transient));auto it=world.arrays.find(id);if(it!=world.arrays.end()){Texture t{};t.image=it->second;retired.push_back({next_completion,t,{}});it->second=image;recycle_cached_array(id);}else world.arrays.emplace(id,image);
    }catch(...){flush_uploads();wait(next_completion);for(auto view:transient.views)vkDestroyImageView(device,view,nullptr);for(auto set:transient.sets)vkFreeDescriptorSets(device,descriptors,1,&set);destroy_image(image);throw;}
}
