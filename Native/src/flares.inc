void init_flares(){
    if(flares.pipeline)return;auto path=std::filesystem::path(shader_directory)/"flare_occlusion_cs.spv";std::ifstream f(path,std::ios::binary|std::ios::ate);if(!f||f.tellg()<20||f.tellg()>1024*1024||f.tellg()%4)throw std::runtime_error("flare shader missing/invalid");std::vector<uint32_t> code(static_cast<size_t>(f.tellg())/4);f.seekg(0);f.read(reinterpret_cast<char*>(code.data()),code.size()*4);SpvReflectShaderModule r{};auto module=world_shader(code.data(),code.size()*4,VK_SHADER_STAGE_COMPUTE_BIT,r);
    bool valid=r.descriptor_binding_count==4&&!r.push_constant_block_count;for(uint32_t i=0;i<r.descriptor_binding_count;++i){auto& b=r.descriptor_bindings[i];valid&=b.set==0&&b.count==1&&((b.binding==0&&b.descriptor_type==SPV_REFLECT_DESCRIPTOR_TYPE_UNIFORM_BUFFER&&b.block.size==80)||((b.binding==1||b.binding==2)&&b.descriptor_type==SPV_REFLECT_DESCRIPTOR_TYPE_STORAGE_BUFFER)||(b.binding==3&&b.descriptor_type==SPV_REFLECT_DESCRIPTOR_TYPE_SAMPLED_IMAGE&&b.image.dim==SpvDim2D&&!b.image.ms&&!b.image.arrayed));}spvReflectDestroyShaderModule(&r);if(!valid){vkDestroyShaderModule(device,module,nullptr);throw std::runtime_error("flare shader interface changed");}
    try{VkDescriptorSetLayoutBinding bindings[]{{0,VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,1,VK_SHADER_STAGE_COMPUTE_BIT,nullptr},{1,VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,1,VK_SHADER_STAGE_COMPUTE_BIT,nullptr},{2,VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,1,VK_SHADER_STAGE_COMPUTE_BIT,nullptr},{3,VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,1,VK_SHADER_STAGE_COMPUTE_BIT,nullptr}};
        VkDescriptorSetLayoutCreateInfo l{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};l.bindingCount=4;l.pBindings=bindings;check(vkCreateDescriptorSetLayout(device,&l,nullptr,&flares.layout),"flare descriptors");flares.pipeline_layout=world_pipeline_layout(flares.layout);
        VkComputePipelineCreateInfo p{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};p.stage={VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,nullptr,0,VK_SHADER_STAGE_COMPUTE_BIT,module,"main",nullptr};p.layout=flares.pipeline_layout;check(vkCreateComputePipelines(device,pipeline_cache,1,&p,nullptr,&flares.pipeline),"flare occlusion pipeline");
        for(uint32_t i=0;i<2;++i){flares.queries[i]=make_buffer(4096*sizeof(SevkFlareRasterQuery),VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,true);flares.results[i]=make_buffer(4096*sizeof(SevkFlareResult),VK_BUFFER_USAGE_STORAGE_BUFFER_BIT|VK_BUFFER_USAGE_TRANSFER_SRC_BIT,false);flares.constants[i]=make_buffer(80,VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT,true);flares.readback[i]=make_buffer(4096*sizeof(SevkFlareResult),VK_BUFFER_USAGE_TRANSFER_DST_BIT,true);}
        vkDestroyShaderModule(device,module,nullptr);
    }catch(...){vkDestroyShaderModule(device,module,nullptr);throw;}
}
void render_flares(VkCommandBuffer cmd,WorldSlot& slot){
    if(flares.valid[slot_index]){auto count=flares.counts[slot_index];check(vmaInvalidateAllocation(allocator,flares.readback[slot_index].memory,0,count*sizeof(SevkFlareResult)),"completed flare results");auto* p=static_cast<SevkFlareResult*>(flares.readback[slot_index].mapped);flares.completed.assign(p,p+count);flares.valid[slot_index]=false;}
    uint32_t count=uint32_t(flares.packet.size()+flares.raster_packet.size());if(!count)return;init_flares();
    auto& queries=flares.queries[slot_index];auto& constants=flares.constants[slot_index];
    auto* rows=static_cast<SevkFlareRasterQuery*>(queries.mapped);
    if(!flares.raster_packet.empty())std::memcpy(rows,flares.raster_packet.data(),count*sizeof(*rows));
    else for(uint32_t i=0;i<count;++i){const auto& q=flares.packet[i];auto& out=rows[i];out={};out.id=q.id;out.center[2]=-1;out.area=1;
        float clip[4]{};for(uint32_t c=0;c<4;++c)clip[c]=q.position[0]*flares.projection[c]+q.position[1]*flares.projection[4+c]+q.position[2]*flares.projection[8+c]+flares.projection[12+c];
        if(clip[3]>0){for(uint32_t c=0;c<3;++c)out.center[c]=clip[c]/clip[3];if(std::abs(out.center[0])>1||std::abs(out.center[1])>1)out.center[2]=-1;
            float radius=std::max(q.radius,.5f);out.half_extent[0]=2*radius/extent.width;out.half_extent[1]=2*radius/extent.height;out.area=16*radius*radius/(float(extent.width)*extent.height);}}
    std::memcpy(constants.mapped,flares.projection,64);uint32_t values[]{extent.width,extent.height,count,0};std::memcpy(static_cast<uint8_t*>(constants.mapped)+64,values,16);
    for(auto* b:{&queries,&constants})check(vmaFlushAllocation(allocator,b->memory,0,VK_WHOLE_SIZE),"flush flare queries");
    barrier(cmd,world.gbuffer[3].handle,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,VK_IMAGE_ASPECT_DEPTH_BIT,VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,VK_ACCESS_2_MEMORY_WRITE_BIT,VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
    auto set=world_set(slot,flares.layout);world_write_buffer(set,0,constants,80,VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER);world_write_buffer(set,1,queries,queries.bytes,VK_DESCRIPTOR_TYPE_STORAGE_BUFFER);world_write_buffer(set,2,flares.results[slot_index],flares.results[slot_index].bytes,VK_DESCRIPTOR_TYPE_STORAGE_BUFFER);world_write_image(set,3,world.gbuffer[3].view);
    vkCmdBindPipeline(cmd,VK_PIPELINE_BIND_POINT_COMPUTE,flares.pipeline);vkCmdBindDescriptorSets(cmd,VK_PIPELINE_BIND_POINT_COMPUTE,flares.pipeline_layout,0,1,&set,0,nullptr);vkCmdDispatch(cmd,count,1,1);particle_dependency(cmd);VkBufferCopy copy{0,0,uint64_t(count)*sizeof(SevkFlareResult)};vkCmdCopyBuffer(cmd,flares.results[slot_index].handle,flares.readback[slot_index].handle,1,&copy);particle_dependency(cmd);
    flares.counts[slot_index]=count;flares.valid[slot_index]=true;
}
void cleanup_flares(){if(flares.pipeline)vkDestroyPipeline(device,flares.pipeline,nullptr);if(flares.pipeline_layout)vkDestroyPipelineLayout(device,flares.pipeline_layout,nullptr);if(flares.layout)vkDestroyDescriptorSetLayout(device,flares.layout,nullptr);for(uint32_t i=0;i<2;++i){destroy_buffer(flares.queries[i]);destroy_buffer(flares.results[i]);destroy_buffer(flares.constants[i]);destroy_buffer(flares.readback[i]);}}
