void set_hbao_jitter(const float* values,uint32_t count){
    if(recording || !values || count!=64)throw std::runtime_error("invalid HBAO jitter state/count");
    for(uint32_t slice=0;slice<16;++slice){auto* v=values+slice*4;for(uint32_t c=0;c<4;++c)if(!std::isfinite(v[c]))throw std::runtime_error("nonfinite HBAO jitter");if(std::abs(v[0]*v[0]+v[1]*v[1]-1.f)>.001f || v[2]<0 || v[2]>1 || v[3]<0 || v[3]>1)throw std::runtime_error("invalid HBAO jitter range");}
    std::memcpy(hbao.jitter,values,sizeof(hbao.jitter));hbao.jitter_provided=true;
}
void set_hbao(const SevkHbaoConfig& config){if(recording || config.size!=sizeof(config) || config.abi_version!=SEVK_ABI_VERSION || config.flags&~7u || config.coarse>15 || config.blur>3 || config.reserved)throw std::runtime_error("invalid HBAO configuration");for(uint32_t i=0;i<200;i+=4){if(i==60 || i==120)continue;float f;std::memcpy(&f,config.constants+i,4);if(!std::isfinite(f))throw std::runtime_error("nonfinite HBAO constant");}hbao.config=config;}
void hbao_targets(){
    if(hbao.width==extent.width && hbao.height==extent.height)return;cleanup_hbao_targets(true);uint32_t qw=(extent.width+3)/4,qh=(extent.height+3)/4;
    post_image(hbao.depth,extent.width,extent.height,VK_FORMAT_R32_SFLOAT);post_image(hbao.normal,extent.width,extent.height,VK_FORMAT_R8G8B8A8_UNORM);for(auto& i:hbao.aoz)post_image(i,extent.width,extent.height,VK_FORMAT_R16G16_SFLOAT);
    hbao.quarter_depth=make_image(qw,qh,VK_FORMAT_R16_SFLOAT,VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT|VK_IMAGE_USAGE_SAMPLED_BIT,VK_IMAGE_ASPECT_COLOR_BIT,1,16,true);hbao.quarter_ao=make_image(qw,qh,VK_FORMAT_R8_UNORM,VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT|VK_IMAGE_USAGE_SAMPLED_BIT,VK_IMAGE_ASPECT_COLOR_BIT,1,16,true);
    for(uint32_t i=0;i<16;++i){VkImageViewCreateInfo v{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};v.viewType=VK_IMAGE_VIEW_TYPE_2D_ARRAY;v.subresourceRange={VK_IMAGE_ASPECT_COLOR_BIT,0,1,i,1};v.image=hbao.quarter_depth.handle;v.format=VK_FORMAT_R16_SFLOAT;check(vkCreateImageView(device,&v,nullptr,&hbao.depth_views[i]),"create HBAO depth slice");v.image=hbao.quarter_ao.handle;v.format=VK_FORMAT_R8_UNORM;check(vkCreateImageView(device,&v,nullptr,&hbao.ao_views[i]),"create HBAO AO slice");}
    hbao.width=extent.width;hbao.height=extent.height;
}
VkDescriptorSet hbao_set(WorldSlot& slot,uint32_t id,uint32_t slice,const std::array<VkImageView,2>& images){auto& stage=post.stages[id];auto set=world_set(slot,stage.layout);
    for(auto [binding,type]:stage.bindings){if(type==VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER){VkDescriptorBufferInfo info{hbao.constants[slot_index].handle,binding==0?0:world_align(208)+world_align(32)*slice,binding==0?208u:32u};VkWriteDescriptorSet w{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};w.dstSet=set;w.dstBinding=binding;w.descriptorCount=1;w.descriptorType=type;w.pBufferInfo=&info;vkUpdateDescriptorSets(device,1,&w,0,nullptr);}
        else if(type==VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE){if(!images[binding-128])throw std::runtime_error("missing HBAO texture");world_write_image(set,binding,images[binding-128]);}
        else{VkSampler sample=id>=54 && id<62 && binding==257?standard_sampler(258):post.point;if(id>=36 && id<=51 && !(hbao.config.flags&4) && binding==256)sample=hbao.border;world_write_image(set,binding,{},sample,true);}}
    return set;
}
void hbao_draw(VkCommandBuffer cmd,WorldSlot& slot,uint32_t id,uint32_t slice,uint32_t width,uint32_t height,const VkImageView* targets,uint32_t count,std::array<VkImageView,2> inputs={}){
    post_note_execution(id);std::array<VkRenderingAttachmentInfo,8> attachments{};for(uint32_t i=0;i<count;++i){auto& a=attachments[i];a.sType=VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;a.imageView=targets[i];a.imageLayout=VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;a.loadOp=VK_ATTACHMENT_LOAD_OP_DONT_CARE;a.storeOp=VK_ATTACHMENT_STORE_OP_STORE;}
    VkRenderingInfo r{VK_STRUCTURE_TYPE_RENDERING_INFO};r.renderArea={{0,0},{width,height}};r.layerCount=1;r.colorAttachmentCount=count;r.pColorAttachments=attachments.data();vkCmdBeginRendering(cmd,&r);auto& s=post.stages[id];auto set=hbao_set(slot,id,slice,inputs);vkCmdBindPipeline(cmd,VK_PIPELINE_BIND_POINT_GRAPHICS,s.pipeline);vkCmdBindDescriptorSets(cmd,VK_PIPELINE_BIND_POINT_GRAPHICS,s.pipeline_layout,0,1,&set,0,nullptr);VkDeviceSize zero=0;vkCmdBindVertexBuffers(cmd,0,1,&world.quad.handle,&zero);world_viewport(cmd,width,height);vkCmdDraw(cmd,3,1,0,0);vkCmdEndRendering(cmd);++post.stats.hbao_passes;
}
void hbao_pass(VkCommandBuffer cmd,WorldSlot& slot,uint32_t id,PostImage& dst,std::array<VkImageView,2> images={}){post_transition(cmd,dst,VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);hbao_draw(cmd,slot,id,0,dst.width,dst.height,&dst.image.view,1,images);post_transition(cmd,dst,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);}
void render_hbao(VkCommandBuffer cmd,WorldSlot& slot){
    hbao_targets();if(!hbao.border){VkSamplerCreateInfo s{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};s.magFilter=s.minFilter=VK_FILTER_NEAREST;s.addressModeU=s.addressModeV=s.addressModeW=VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER;s.borderColor=VK_BORDER_COLOR_FLOAT_OPAQUE_WHITE;check(vkCreateSampler(device,&s,nullptr,&hbao.border),"create stock HBAO border sampler");}
    auto& buffer=hbao.constants[slot_index];world_buffer(buffer,world_align(208)+16*world_align(32),VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT);std::memset(buffer.mapped,0,208);std::memcpy(buffer.mapped,hbao.config.constants,200);
    for(uint32_t i=0;i<16;++i){float angle=float(i)*.61803398875f;angle=(angle-std::floor(angle))*.7853981634f;float pass[]{std::cos(angle),std::sin(angle),float((i*37+13)%101)/101.f,float((i*67+29)%103)/103.f,float(i%4)+.5f,float(i/4)+.5f,float(i),std::bit_cast<float>(i)};if(hbao.jitter_provided)std::memcpy(pass,hbao.jitter+i*4,16);std::memcpy(static_cast<uint8_t*>(buffer.mapped)+world_align(208)+world_align(32)*i,pass,32);}check(vmaFlushAllocation(allocator,buffer.memory,0,VK_WHOLE_SIZE),"flush HBAO data and sixteen stable jitter slices");
    hbao_pass(cmd,slot,33,hbao.depth,{world.gbuffer[3].view});uint32_t qw=(extent.width+3)/4,qh=(extent.height+3)/4;
    auto array_transition=[&](Image& image,VkImageLayout old_layout,VkImageLayout layout){barrier(cmd,image.handle,old_layout,layout,VK_IMAGE_ASPECT_COLOR_BIT,old_layout?VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT:VK_PIPELINE_STAGE_2_NONE,old_layout?VK_ACCESS_2_MEMORY_READ_BIT|VK_ACCESS_2_MEMORY_WRITE_BIT:0,VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,VK_ACCESS_2_MEMORY_READ_BIT|VK_ACCESS_2_MEMORY_WRITE_BIT,1,16);};
    array_transition(hbao.quarter_depth,hbao.initialized?VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL:VK_IMAGE_LAYOUT_UNDEFINED,VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);for(uint32_t i=0;i<16;i+=8)hbao_draw(cmd,slot,34,i,qw,qh,hbao.depth_views+i,8,{hbao.depth.image.view});array_transition(hbao.quarter_depth,VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
    VkImageView normals=world.gbuffer[1].view;if(!(hbao.config.coarse&8)){hbao_pass(cmd,slot,35,hbao.normal,{hbao.depth.image.view});normals=hbao.normal.image.view;}
    array_transition(hbao.quarter_ao,hbao.initialized?VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL:VK_IMAGE_LAYOUT_UNDEFINED,VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);for(uint32_t i=0;i<16;++i)hbao_draw(cmd,slot,(!(hbao.config.flags&4)&&post.stages[128+hbao.config.coarse].pipeline?128u:36u)+hbao.config.coarse,i,qw,qh,hbao.ao_views+i,1,{hbao.depth_views[i],normals});array_transition(hbao.quarter_ao,VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);hbao.initialized=true;
    if(hbao.config.flags&2){hbao_pass(cmd,slot,53,hbao.aoz[0],{hbao.quarter_ao.view,hbao.depth.image.view});hbao_pass(cmd,slot,54+2*hbao.config.blur,hbao.aoz[1],{hbao.aoz[0].image.view});hbao_pass(cmd,slot,55+2*hbao.config.blur,post.ao,{hbao.aoz[1].image.view});}
    else hbao_pass(cmd,slot,52,post.ao,{hbao.quarter_ao.view});
}
void cleanup_hbao_targets(bool defer=false){for(uint32_t i=0;i<16;++i){if(defer){retire_view(hbao.depth_views[i]);retire_view(hbao.ao_views[i]);}else{if(hbao.depth_views[i])vkDestroyImageView(device,hbao.depth_views[i],nullptr);if(hbao.ao_views[i])vkDestroyImageView(device,hbao.ao_views[i],nullptr);}hbao.depth_views[i]=hbao.ao_views[i]={};}if(defer){retire_image(hbao.quarter_depth);retire_image(hbao.quarter_ao);}else{destroy_image(hbao.quarter_depth);destroy_image(hbao.quarter_ao);}for(auto* i:{&hbao.depth,&hbao.normal,&hbao.aoz[0],&hbao.aoz[1]}){if(defer)retire_image(i->image);else destroy_image(i->image);*i={};}hbao.initialized=false;hbao.width=hbao.height=0;}
void cleanup_hbao(){cleanup_hbao_targets();for(auto& b:hbao.constants)destroy_buffer(b);if(hbao.border)vkDestroySampler(device,hbao.border,nullptr);hbao={};}
