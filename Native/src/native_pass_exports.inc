static_assert(sizeof(SevkPassProfile)==136);
static_assert(sizeof(SevkPassTransparent)==24);
int32_t SEVK_CALL sevk_pass_register_mixed_model(void* ctx,const SevkPassPart* parts,uint32_t count,uint32_t glass,uint64_t* handle){return call(ctx,[&](Renderer& r){if(!handle||glass>1)throw std::runtime_error("invalid mixed model output");*handle=r.register_pass_model(parts,count,glass!=0);return 0;});}
int32_t SEVK_CALL sevk_pass_transparent_requests(void* ctx,SevkPassTransparent* requests,uint32_t capacity,uint32_t* count){return call_scene(ctx,[&](Renderer& r){if(!count)throw std::runtime_error("missing transparent request count");auto& tickets=r.pass_scene.scene.transparent_requests();*count=uint32_t(tickets.size());if(requests){if(capacity<*count)throw std::runtime_error("transparent request capacity");uint32_t i=0;for(auto& ticket:tickets)requests[i++]={ticket.actor,ticket.owner,ticket.lod,ticket.alpha,0};}return 0;});}
int32_t SEVK_CALL sevk_pass_init_pipeline(void* ctx,uint32_t id,const void* vertex,uint64_t vb,const void* pixel,uint64_t pb){return call(ctx,[&](Renderer& r){r.init_pass_pipeline(id,vertex,vb,pixel,pb);return 0;});}
int32_t SEVK_CALL sevk_pass_set_placeholder(void* ctx,const void* bytes,uint32_t count){return call(ctx,[&](Renderer& r){if(r.recording||!bytes||count!=128)throw std::runtime_error("invalid native pass placeholder");std::memcpy(r.pass_scene.placeholder.data(),bytes,128);return 0;});}
int32_t SEVK_CALL sevk_pass_register_model(void* ctx,const SevkPassPart* parts,uint32_t count,uint64_t* handle){return call(ctx,[&](Renderer& r){if(!handle)throw std::runtime_error("missing native model output");*handle=r.register_pass_model(parts,count);return 0;});}
int32_t SEVK_CALL sevk_pass_register_family(void* ctx,const float* distances,uint32_t count,uint64_t* handle){return call(ctx,[&](Renderer& r){if(r.recording||!handle||count>1024||(!distances&&count))throw std::runtime_error("invalid native pass family");std::vector<float> copied;if(count)copied.assign(distances,distances+count);*handle=r.pass_scene.scene.register_family(std::move(copied));return 0;});}
int32_t SEVK_CALL sevk_pass_bind_level(void* ctx,uint64_t family,uint32_t lod,uint64_t model){return call(ctx,[&](Renderer& r){if(r.recording)throw std::runtime_error("native LOD bind during recording");r.pass_scene.scene.bind_level(family,lod,model);return 0;});}
int32_t SEVK_CALL sevk_pass_register_actor(void* ctx,const SevkPassActor* actor,const SevkPassAppearance* appearance,uint32_t count,uint64_t* handle){return call(ctx,[&](Renderer& r){if(r.recording||!actor||!handle)throw std::runtime_error("invalid native actor registration");*handle=r.pass_scene.scene.register_actor(r.pass_actor_input(*actor,appearance,count));return 0;});}
int32_t SEVK_CALL sevk_pass_update_actors(void* ctx,const SevkPassActor* actors,uint32_t count,const SevkPassAppearance* appearance,uint32_t appearance_count){return call_deferrable_scene(ctx,[actors_copy=copy_in(actors,count),count,appearance_copy=copy_in(appearance,appearance_count),appearance_count](Renderer& r){auto* actors=actors_copy.get();auto* appearance=appearance_copy.get();if(r.frame_open()||count>1000000||(!actors&&count))throw std::runtime_error("invalid native actor commit");auto& scene=r.pass_scene.scene;native_pass::Scene::CpuScope commit(scene.profiling,scene.profile.commits_us);if(scene.profiling)scene.profile.committed_actors+=count;std::vector<std::pair<uint64_t,native_pass::Actor>> copied;copied.reserve(count);{native_pass::Scene::CpuScope parse(scene.profiling,scene.profile.actor_parse_us);for(uint32_t i=0;i<count;i++){if(scene.profiling)scene.profile.appearance_entries+=actors[i].appearance_count;copied.emplace_back(actors[i].handle,r.pass_actor_input(actors[i],appearance,appearance_count));}}{native_pass::Scene::CpuScope apply(scene.profiling,scene.profile.actor_apply_us);scene.update_actors(std::move(copied));}return 0;});}
int32_t SEVK_CALL sevk_pass_remove(void* ctx,uint32_t kind,uint64_t handle){return call(ctx,[&](Renderer& r){if(r.recording||kind>2)throw std::runtime_error("invalid pass retirement");if(kind==0)r.pass_scene.scene.remove_model(handle);else if(kind==1)r.pass_scene.scene.remove_family(handle);else r.pass_scene.scene.remove_actor(handle);return 0;});}
// A scene call like sevk_pass_prepare: as an ordinary call it waited for the in-flight recording mid-Draw, which made
// early preparation 0.6-0.9 ms slower even though every prepared frame was kept.
int32_t SEVK_CALL sevk_pass_prepare_async(void* ctx,const SevkSceneFrame* frame,const SevkPassView* views,uint32_t count){return call_scene(ctx,[&](Renderer& r){if(!frame)throw std::runtime_error("missing native frame");r.prepare_pass_frame(*frame,views,count,true);return 0;});}
int32_t SEVK_CALL sevk_pass_prepare(void* ctx,const SevkSceneFrame* frame,const SevkPassView* views,uint32_t count){return call_scene(ctx,[&](Renderer& r){if(!frame)throw std::runtime_error("missing native frame");r.prepare_pass_frame(*frame,views,count);return 0;});}
int32_t SEVK_CALL sevk_pass_get_preparation(void* ctx,SevkPassQuery* queries,uint32_t query_capacity,uint32_t* query_count,SevkPassMissing* missing,uint32_t missing_capacity,uint32_t* missing_count,SevkPassFallback* fallback,uint32_t fallback_capacity,uint32_t* fallback_count){return call_scene(ctx,[&](Renderer& r){if(!query_count||!missing_count||!fallback_count)throw std::runtime_error("missing native preparation counts");auto& scene=r.pass_scene.scene;*query_count=uint32_t(scene.query_owners().size());*missing_count=uint32_t(scene.missing_levels().size());*fallback_count=uint32_t(scene.explicit_fallbacks().size());if(queries){if(query_capacity<*query_count)throw std::runtime_error("native query owner capacity");uint32_t i=0;for(auto& item:scene.query_owners())queries[i++]={item.group,item.views,item.representative,0};}if(missing){if(missing_capacity<*missing_count)throw std::runtime_error("native LOD request capacity");uint32_t i=0;for(auto& item:scene.missing_levels())missing[i++]={item.family,item.lod,0};}if(fallback){if(fallback_capacity<*fallback_count)throw std::runtime_error("native fallback capacity");uint32_t i=0;for(auto& item:scene.explicit_fallbacks())fallback[i++]={item.actor,item.owner,0,{item.lod.current,item.lod.previous,item.lod.transition,item.lod.start,item.lod.initialized?1u:0u},0};}return 0;});}
int32_t SEVK_CALL sevk_pass_publish(void* ctx,const SevkPassQueryResult* results,uint32_t count){return call_scene(ctx,[&](Renderer& r){if(r.frame_open()||count>1000000||(!results&&count))throw std::runtime_error("invalid pass visibility publication");std::vector<native_pass::QueryResult> copied;copied.reserve(count);for(uint32_t i=0;i<count;i++)copied.push_back({results[i].group,results[i].hidden_views});{critical_profile::Scope scope(critical_profile::PassPublish,true);r.pass_scene.scene.publish(copied);}r.pass_scene.ready=true;uint64_t changed=r.pass_scene.scene.static_spot_updates();for(uint32_t light=0;light<64;++light){uint32_t view=r.pass_scene.spot_views[light];if(view&&(changed&(uint64_t(1)<<view)))r.pass_scene.static_dirty|=uint64_t(1)<<light;}return 0;});}
int32_t SEVK_CALL sevk_pass_cancel(void* ctx){return call_scene(ctx,[&](Renderer& r){if(r.frame_open())throw std::runtime_error("native cancel during recording");r.pass_scene.scene.cancel();r.pass_scene.ready=false;return 0;});}

int32_t SEVK_CALL sevk_pass_clear_frame(void* ctx){return call_deferrable_scene(ctx,[](Renderer& r){if(r.frame_open())throw std::runtime_error("native clear during recording");r.pass_scene.scene.clear_frame();r.pass_scene.ready=false;r.pass_scene.spot_views.fill(0);return 0;});}
int32_t SEVK_CALL sevk_pass_actor_selector(void* ctx,uint64_t handle,uint32_t write,SevkSceneLod* lod,double* camera,uint32_t* have_camera){return call(ctx,[&](Renderer& r){if(r.recording||write>1||!lod||!camera||!have_camera)throw std::runtime_error("invalid selector handoff");auto& actor=r.pass_scene.scene.actor_state(handle);if(write){if(lod->current<0||lod->previous<-1||!std::isfinite(lod->transition)||!std::isfinite(lod->start))throw std::runtime_error("invalid selector state");actor.lod={lod->current,lod->previous,lod->transition,lod->start,lod->initialized!=0};actor.last_camera={camera[0],camera[1],camera[2]};actor.have_camera=*have_camera!=0;}else{*lod={actor.lod.current,actor.lod.previous,actor.lod.transition,actor.lod.start,actor.lod.initialized?1u:0u};camera[0]=actor.last_camera.x;camera[1]=actor.last_camera.y;camera[2]=actor.last_camera.z;*have_camera=actor.have_camera?1u:0u;}return 0;});}

int32_t SEVK_CALL sevk_pass_visible_owners(void* ctx,uint32_t* owners,uint32_t capacity,uint32_t* count){return call_scene(ctx,[&](Renderer& r){if(!count)throw std::runtime_error("missing visible owner count");auto& visible=r.pass_scene.scene.main_visible_owners();*count=uint32_t(visible.size());if(owners){if(capacity<*count)throw std::runtime_error("visible owner capacity");std::copy(visible.begin(),visible.end(),owners);}return 0;});}

int32_t SEVK_CALL sevk_pass_group_audit(void* ctx,SevkPassGroupAudit* output,uint32_t capacity,uint32_t* count,uint32_t* owners,uint32_t owner_capacity,uint32_t* owner_count){return call(ctx,[&](Renderer& r){if(!count||!owner_count)throw std::runtime_error("missing diagnostic counts");auto& groups=r.pass_scene.scene.render_groups();*count=uint32_t(groups.size());*owner_count=0;for(auto& group:groups)*owner_count+=uint32_t(group.stream->owners.size());if((output&&capacity<*count)||(owners&&owner_capacity<*owner_count))throw std::runtime_error("native group audit capacity");uint32_t index=0,at=0;for(auto& group:groups){auto& k=group.key;if(output)output[index]={k.view,uint32_t(group.kind),k.shader,k.first,k.count,group.count(),at,(k.masked?1u:0u)|(k.double_sided?2u:0u),k.mesh,k.colour,k.normal,k.extensions,k.alpha};if(owners)std::copy(group.stream->owners.begin(),group.stream->owners.end(),owners+at);at+=uint32_t(group.stream->owners.size());++index;}return 0;});}

int32_t SEVK_CALL sevk_pass_profile(void* ctx,uint32_t enable,SevkPassProfile* output){return call(ctx,[&](Renderer& r){if(enable>1||!output||(output->size!=112&&output->size!=sizeof(*output))||output->abi_version!=SEVK_ABI_VERSION)throw std::runtime_error("invalid pass profile output");auto& scene=r.pass_scene.scene;scene.settle();scene.profiling=enable!=0;auto& p=scene.profile;uint32_t bytes=output->size;SevkPassProfile result{bytes,SEVK_ABI_VERSION,p.prepares,p.publishes,p.committed_actors,p.selected_actors,p.emitted_rows,p.stream_bytes,p.groups,p.commits_us,p.prepare_us,p.requests_us,p.publish_us,p.emit_us,p.spots_us,p.appearance_entries,p.actor_parse_us,p.actor_apply_us};std::memcpy(output,&result,bytes);return 0;});}
