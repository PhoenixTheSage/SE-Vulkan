// Plan 4 milestone 2: registry and per-frame calls are scene calls, so Build runs them alongside an early-released
// recording; begin_frame latches the frame inputs. Publication, clear and selector handoff still wait.
int32_t SEVK_CALL sevk_gpu_scene_model(void* ctx,const SevkPassPart* parts,uint32_t count,uint32_t old,uint64_t* handle){return call_scene(ctx,[&](Renderer& r){if(!handle)throw std::runtime_error("missing resident model output");*handle=r.register_gpu_scene_model(parts,count,old);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_model_ordered(void* ctx,const SevkPassPart* parts,const SevkOldPartOrder* orders,uint32_t count,uint32_t old,uint64_t* handle){return call_scene(ctx,[&](Renderer& r){if(!handle||!orders)throw std::runtime_error("missing ordered resident model input");*handle=r.register_gpu_scene_model(parts,count,old,orders);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_family(void* ctx,const float* distances,uint32_t count,const uint64_t* levels,uint64_t* handle){return call_scene(ctx,[&](Renderer& r){if(r.own_frame_open()||!handle||count>16||(!distances&&count)||!levels)throw std::runtime_error("invalid resident family inputs");std::vector<float> values;if(count)values.assign(distances,distances+count);*handle=r.gpu_resident.registry.register_family(std::move(values),std::span(levels,count+1));return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_source(void* ctx,const void* bytes,uint32_t count,uint32_t cube,uint64_t* handle){return call_scene(ctx,[&](Renderer& r){if(r.own_frame_open()||!handle||!bytes||!count||count%64||count>gpu_opaque::storage_range||cube>1)throw std::runtime_error("invalid resident source inputs");gpu_scene::Source source;source.cube=cube!=0;source.bytes.assign(static_cast<const uint8_t*>(bytes),static_cast<const uint8_t*>(bytes)+count);*handle=r.gpu_resident.registry.register_source(std::move(source));return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_actor(void* ctx,const SevkGpuSceneActor* actor,const SevkOpaqueAppearance* appearances,uint32_t count,uint64_t* handle){return call_scene(ctx,[&](Renderer& r){if(r.own_frame_open()||!actor||actor->handle||!handle)throw std::runtime_error("invalid resident actor registration");*handle=r.gpu_resident.registry.register_actor(r.gpu_scene_actor_input(*actor,appearances,count));return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_updates(void* ctx,const SevkGpuSceneActor* actors,uint32_t count,const SevkOpaqueAppearance* appearances,uint32_t total){return call_scene(ctx,[&](Renderer& r){if(r.own_frame_open()||count>8192||(!actors&&count))throw std::runtime_error("invalid resident actor batch");std::vector<std::pair<uint64_t,gpu_scene::Actor>> updates;updates.reserve(count);for(uint32_t i=0;i<count;i++)updates.emplace_back(actors[i].handle,r.gpu_scene_actor_input(actors[i],appearances,total));r.gpu_resident.registry.update(updates);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_publish(void* ctx,uint32_t views,uint32_t references,uint32_t draws){return call(ctx,[&](Renderer& r){r.publish_gpu_scene(views,references,draws);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_frame(void* ctx,const SevkOpaqueFrame* frame,const SevkOpaqueView* views,uint32_t count){return call_scene(ctx,[&](Renderer& r){if(!frame)throw std::runtime_error("missing resident frame");r.queue_gpu_scene_frame(*frame,views,count);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_selector(void* ctx,uint64_t actor,SevkOpaqueSelector* selector){return call(ctx,[&](Renderer& r){if(!selector)throw std::runtime_error("missing selector output");r.gpu_scene_selector(actor,*selector);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_remove(void* ctx,uint32_t kind,uint64_t handle){return call_scene(ctx,[&](Renderer& r){if(r.own_frame_open()||kind>3)throw std::runtime_error("invalid resident retirement");auto& registry=r.gpu_resident.registry;if(kind==0)registry.retire_model(handle);else if(kind==1)registry.retire_family(handle);else if(kind==2)registry.remove_actor(handle);else registry.retire_source(handle);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_queries(void* ctx,const SevkOpaqueView* views,uint32_t count,SevkPassQuery* queries,uint32_t capacity,uint32_t* total){return call_scene(ctx,[&](Renderer& r){if(!total)throw std::runtime_error("missing query count");r.gpu_scene_queries(views,count,queries,capacity,*total);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_visibility(void* ctx,const SevkPassQueryResult* results,uint32_t count){return call_scene(ctx,[&](Renderer& r){r.gpu_scene_visibility(results,count);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_clear(void* ctx){return call(ctx,[&](Renderer& r){if(r.recording)throw std::runtime_error("resident clear during recording");r.wait(r.next_completion);r.invalidate_indexed_motion_history();r.cleanup_opaque_reference();r.opaque_stock.ready=false;r.gpu_resident={};return 0;});}

int32_t SEVK_CALL sevk_readback_spot(void* ctx,uint32_t light,void* data,uint64_t bytes){return call(ctx,[&](Renderer& r){r.readback_spot(light,data,bytes);return 0;});}

int32_t SEVK_CALL sevk_gpu_scene_supported(void* ctx,uint32_t* supported){return call(ctx,[&](Renderer& r){if(!supported)throw std::runtime_error("missing resident support output");*supported=r.opaque_caps.enabled&&r.opaque_conditional;return 0;});}

int32_t SEVK_CALL sevk_gpu_scene_topology_counts(void* ctx,uint64_t* counts,uint32_t count){return call(ctx,[&](Renderer& r){if(!counts||count!=7)throw std::runtime_error("resident topology counter output");std::copy(r.gpu_resident.registry.topology_counts().begin(),r.gpu_resident.registry.topology_counts().end(),counts);counts[5]=r.gpu_resident.publications;counts[6]=r.gpu_resident.frames;return 0;});}

int32_t SEVK_CALL sevk_gpu_scene_compute_times(void* ctx,uint64_t* values,uint32_t count){return call(ctx,[&](Renderer& r){if(!values||count!=11)throw std::runtime_error("resident compute timing output");std::copy(r.opaque_compute_times.begin(),r.opaque_compute_times.end(),values);return 0;});}
int32_t SEVK_CALL sevk_gpu_scene_cpu_costs(void* ctx,uint64_t* values,uint32_t count){return call(ctx,[&](Renderer& r){if(!values||count!=GpuSceneCosts::Count*2)throw std::runtime_error("resident CPU timing output");std::copy(r.gpu_scene_costs.values.begin(),r.gpu_scene_costs.values.end(),values);return 0;});}
