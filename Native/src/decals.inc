}
void render_decal_batches(VkCommandBuffer cmd,WorldSlot& slot,bool transparent,VkImageView depth_view={}){
    for(uint32_t i=0;i<decals.batches.size();++i){auto& b=decals.batches[i];if((b.role==8)!=transparent)continue;auto set=world_set(slot,decals.layout);world_write_buffer(set,0,slot.frame,1280,VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER);world_write_buffer(set,2,decals.constants[slot_index],65536,VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC);if(transparent){world_write_buffer(set,4,transparency.shadow_constants[slot_index],1200,VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER);world_write_image(set,139,world.ambient.view);world_write_image(set,145,world.ambient.view);world_write_image(set,144,transparency.csm.view);world_write_image(set,271,{},shadow_sampler,true);}
