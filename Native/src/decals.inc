void prepare_decals(VkCommandBuffer cmd,WorldSlot& slot){
    decals.batches.clear();if(decals.draws.empty())return;
    if(decals.width!=extent.width||decals.height!=extent.height){retire_image(decals.normals);decals.normals=make_image(extent.width,extent.height,stock_formats[1],VK_IMAGE_USAGE_TRANSFER_DST_BIT|VK_IMAGE_USAGE_SAMPLED_BIT|VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,VK_IMAGE_ASPECT_COLOR_BIT);decals.width=extent.width;decals.height=extent.height;decals.initialized=false;}
