        if(shadow_depth_bias_clamp)shadow_occlusion_pipeline=world_graphics(vs,"__vertex_shader",ps,"__pixel_shader",occlusion.pipeline_layout,{{0,24,VK_VERTEX_INPUT_RATE_INSTANCE}},attributes,nullptr,0,true,true,false,false,0,true,{},false,true,true,true);
        VkQueryPoolCreateInfo q{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};q.queryType=VK_QUERY_TYPE_OCCLUSION;q.queryCount=16384;check(vkCreateQueryPool(device,&q,nullptr,&occlusion.pool),"create asynchronous visibility queries");spvReflectDestroyShaderModule(&vr);spvReflectDestroyShaderModule(&pr);vkDestroyShaderModule(device,vs,nullptr);vkDestroyShaderModule(device,ps,nullptr);
    }catch(...){if(vr._internal)spvReflectDestroyShaderModule(&vr);if(pr._internal)spvReflectDestroyShaderModule(&pr);if(vs)vkDestroyShaderModule(device,vs,nullptr);if(ps)vkDestroyShaderModule(device,ps,nullptr);throw;}
}
void queue_occlusion_view(OcclusionState& state,uint64_t token,const SevkOcclusionDraw* draws,uint32_t count){
    if(recording || count>8192 || (!draws && count) || (!token && count))throw std::runtime_error("invalid occlusion packet");std::unordered_map<uint64_t,bool> ids;std::vector<SevkOcclusionDraw> copied;copied.reserve(count);
    for(uint32_t i=0;i<count;++i){auto d=draws[i];if(d.flags>1 || d.reserved || !ids.emplace(d.id,true).second)throw std::runtime_error("duplicate/invalid occlusion identity");for(uint32_t j=0;j<3;++j)if(!std::isfinite(d.minimum[j]) || !std::isfinite(d.extents[j]) || d.extents[j]<0)throw std::runtime_error("invalid occlusion bounds");copied.push_back(d);}state.packet=std::move(copied);state.token=token;
}
void sample_occlusion_view(OcclusionState& state,uint32_t index){
    if(!state.valid[index])return;auto& input=state.submitted[index];std::vector<uint64_t> data(input.size()*2);auto result=vkGetQueryPoolResults(device,state.pool,index*8192,uint32_t(input.size()),data.size()*8,data.data(),16,VK_QUERY_RESULT_64_BIT|VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);if(result==VK_NOT_READY)return;check(result,"read completed visibility queries");
    std::vector<SevkOcclusionResult> completed;completed.reserve(input.size());for(uint32_t i=0;i<input.size();++i){bool visible=input[i].flags || !data[i*2+1] || data[i*2];completed.push_back({input[i].id,visible?1u:0u,0});++state.stats.results;if(!visible)++state.stats.occluded;}
    if(state.tokens[index]>state.completed_token){state.completed=std::move(completed);state.completed_token=state.tokens[index];state.stats.token=state.completed_token;}state.valid[index]=false;
}
void render_occlusion_view(OcclusionState& state,VkCommandBuffer cmd,WorldSlot& slot,Image& image,Buffer& projection,VkExtent2D viewport){
    if(state.packet.empty())return;if(!state.pipeline)throw std::runtime_error("stock occlusion pipeline unavailable");uint32_t count=uint32_t(state.packet.size());auto& boxes=state.boxes[slot_index];world_buffer(boxes,uint64_t(count)*24,VK_BUFFER_USAGE_VERTEX_BUFFER_BIT);for(uint32_t i=0;i<count;++i){std::memcpy(static_cast<uint8_t*>(boxes.mapped)+i*24,state.packet[i].minimum,12);std::memcpy(static_cast<uint8_t*>(boxes.mapped)+i*24+12,state.packet[i].extents,12);}check(vmaFlushAllocation(allocator,boxes.memory,0,VK_WHOLE_SIZE),"flush copied occlusion bounds");vkCmdResetQueryPool(cmd,state.pool,slot_index*8192,count);
    barrier(cmd,image.handle,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,VK_IMAGE_LAYOUT_DEPTH_READ_ONLY_OPTIMAL,VK_IMAGE_ASPECT_DEPTH_BIT,VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,VK_ACCESS_2_MEMORY_READ_BIT,VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT|VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT,VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT);
    VkRenderingAttachmentInfo depth{VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};depth.imageView=image.view;depth.imageLayout=VK_IMAGE_LAYOUT_DEPTH_READ_ONLY_OPTIMAL;depth.loadOp=VK_ATTACHMENT_LOAD_OP_LOAD;depth.storeOp=VK_ATTACHMENT_STORE_OP_NONE;VkRenderingInfo rendering{VK_STRUCTURE_TYPE_RENDERING_INFO};rendering.renderArea={{0,0},viewport};rendering.layerCount=1;rendering.pDepthAttachment=&depth;vkCmdBeginRendering(cmd,&rendering);world_viewport(cmd,viewport.width,viewport.height);auto set=world_set(slot,state.layout);world_write_buffer(set,1,projection,64,VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER);vkCmdBindPipeline(cmd,VK_PIPELINE_BIND_POINT_GRAPHICS,state.pipeline);vkCmdBindDescriptorSets(cmd,VK_PIPELINE_BIND_POINT_GRAPHICS,state.pipeline_layout,0,1,&set,0,nullptr);VkDeviceSize zero=0;vkCmdBindVertexBuffers(cmd,0,1,&boxes.handle,&zero);
    for(uint32_t i=0;i<count;++i){vkCmdBeginQuery(cmd,state.pool,slot_index*8192+i,0);if(!state.packet[i].flags)vkCmdDraw(cmd,14,1,0,i);vkCmdEndQuery(cmd,state.pool,slot_index*8192+i);}vkCmdEndRendering(cmd);
    barrier(cmd,image.handle,VK_IMAGE_LAYOUT_DEPTH_READ_ONLY_OPTIMAL,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,VK_IMAGE_ASPECT_DEPTH_BIT,VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT|VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT,VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT,VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);state.submitted[slot_index]=state.packet;state.tokens[slot_index]=state.token;state.valid[slot_index]=true;++state.stats.frames;state.stats.queries+=count;
}
void queue_occlusion(uint64_t token,const SevkOcclusionDraw* draws,uint32_t count){queue_occlusion_view(occlusion,token,draws,count);}
void sample_occlusion(uint32_t index){sample_occlusion_view(occlusion,index);for(auto& state:shadow_occlusion)sample_occlusion_view(state,index);}
void render_occlusion(VkCommandBuffer cmd,WorldSlot& slot){render_occlusion_view(occlusion,cmd,slot,world.gbuffer[3],slot.projections,extent);}
void queue_shadow_occlusion(uint32_t cascade,uint64_t token,const SevkOcclusionDraw* draws,uint32_t count){
    if(cascade>=8)throw std::runtime_error("invalid cascade query view");auto& state=shadow_occlusion[cascade];
    if(count && !state.pool){if(!shadow_occlusion_pipeline)throw std::runtime_error("stock cascade query rasterizer unavailable");state.layout=occlusion.layout;state.pipeline_layout=occlusion.pipeline_layout;state.pipeline=shadow_occlusion_pipeline;VkQueryPoolCreateInfo info{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};info.queryType=VK_QUERY_TYPE_OCCLUSION;info.queryCount=16384;check(vkCreateQueryPool(device,&info,nullptr,&state.pool),"create cascade-owned visibility query pool");}
