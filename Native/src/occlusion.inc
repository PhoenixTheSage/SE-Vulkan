}
void render_shadow_occlusion(VkCommandBuffer cmd,WorldSlot& slot,uint32_t cascade){
    auto& state=shadow_occlusion[cascade];if(state.packet.empty())return;auto& projection=state.projections[slot_index];world_buffer(projection,64,VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT);std::memcpy(projection.mapped,shadow_matrices[cascade],64);check(vmaFlushAllocation(allocator,projection.memory,0,64),"flush cascade query projection");render_occlusion_view(state,cmd,slot,shadow_images[cascade],projection,{shadow_resolution,shadow_resolution});
}
void cleanup_occlusion(){for(auto& state:shadow_occlusion){for(auto& b:state.boxes)destroy_buffer(b);for(auto& b:state.projections)destroy_buffer(b);if(state.pool)vkDestroyQueryPool(device,state.pool,nullptr);}if(shadow_occlusion_pipeline)vkDestroyPipeline(device,shadow_occlusion_pipeline,nullptr);for(auto& b:occlusion.boxes)destroy_buffer(b);if(occlusion.pool)vkDestroyQueryPool(device,occlusion.pool,nullptr);if(occlusion.pipeline)vkDestroyPipeline(device,occlusion.pipeline,nullptr);if(occlusion.pipeline_layout)vkDestroyPipelineLayout(device,occlusion.pipeline_layout,nullptr);if(occlusion.layout)vkDestroyDescriptorSetLayout(device,occlusion.layout,nullptr);}
