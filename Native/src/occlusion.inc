void init_occlusion(const void* vertex,uint64_t vb,const void* pixel,uint64_t pb){
    if(recording || occlusion.pipeline)throw std::runtime_error("invalid occlusion initialization");SpvReflectShaderModule vr{},pr{};VkShaderModule vs{},ps{};
    try{vs=world_shader(vertex,vb,VK_SHADER_STAGE_VERTEX_BIT,vr);ps=world_shader(pixel,pb,VK_SHADER_STAGE_FRAGMENT_BIT,pr);for(auto* r:{&vr,&pr})for(uint32_t i=0;i<r->descriptor_binding_count;++i){auto& b=r->descriptor_bindings[i];if(b.set || b.binding!=1 || b.count!=1 || b.descriptor_type!=SPV_REFLECT_DESCRIPTOR_TYPE_UNIFORM_BUFFER || b.block.size!=64)throw std::runtime_error("stock group occlusion descriptor mismatch");}
        std::vector<VkVertexInputAttributeDescription> attributes;for(uint32_t i=0;i<vr.input_variable_count;++i){auto& v=*vr.input_variables[i];if(v.decoration_flags&SPV_REFLECT_DECORATION_BUILT_IN)continue;if(v.location>1 || v.format!=SPV_REFLECT_FORMAT_R32G32B32_SFLOAT)throw std::runtime_error("stock group occlusion vertex mismatch");attributes.push_back({v.location,0,VK_FORMAT_R32G32B32_SFLOAT,v.location*12});}
