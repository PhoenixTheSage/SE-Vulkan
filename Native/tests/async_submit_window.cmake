cmake_minimum_required(VERSION 3.24)

set(ENV{SE_VULKAN_ASYNC_SUBMIT} "1")
set(ENV{SE_VULKAN_DECOUPLED_PRESENT} "1")
set(ENV{SE_VULKAN_ASYNC_PRESENT} "1")
set(ENV{SE_VULKAN_RECORD_TIMING} "${REPORT}")
file(REMOVE "${REPORT}")
execute_process(COMMAND "${SMOKE}" "${SHADERS}" --window --verify-async-submit RESULT_VARIABLE result)
if(result STREQUAL "77")
  message("SKIP: async-submit HWND has no suitable Vulkan device")
  return()
elseif(NOT result STREQUAL "0")
  message(FATAL_ERROR "HWND smoke returned ${result}")
endif()

file(READ "${REPORT}" report)
string(JSON frames GET "${report}" Frames)
string(JSON counters LENGTH "${report}" Counters)
math(EXPR last "${counters} - 1")
foreach(i RANGE 0 ${last})
  string(JSON name GET "${report}" Counters ${i} Name)
  if(name STREQUAL "async frame submit active")
    string(JSON samples GET "${report}" Counters ${i} Samples)
    string(JSON fraction GET "${report}" Counters ${i} PerFrame)
    if(samples LESS 48 OR NOT samples EQUAL frames)
      message(FATAL_ERROR "Incomplete FIFO admission counter: ${samples} samples, ${frames} frames")
    elseif(fraction EQUAL 0)
      message("SKIP: async-submit HWND did not enter decoupled submission on this device")
    elseif(fraction LESS 0 OR fraction GREATER_EQUAL 1)
      message(FATAL_ERROR "Expected direct and FIFO frame submissions, observed FIFO fraction ${fraction}")
    else()
      message(STATUS "HWND FIFO submission fraction ${fraction} over ${samples} frames")
    endif()
    return()
  endif()
endforeach()
message(FATAL_ERROR "Missing async frame submit admission counter")
