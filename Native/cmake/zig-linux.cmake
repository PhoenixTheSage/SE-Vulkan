set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT SEVK_ZIG_EXECUTABLE)
  message(FATAL_ERROR "Set SEVK_ZIG_EXECUTABLE to pinned Zig 0.14.1 zig.exe")
endif()
set(CMAKE_C_COMPILER "${SEVK_ZIG_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER "${SEVK_ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 c++)
set(CMAKE_C_FLAGS_INIT "-target x86_64-linux-gnu.2.31")
set(CMAKE_CXX_FLAGS_INIT "-target x86_64-linux-gnu.2.31")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SEVK_ZIG_EXECUTABLE)
# Zig's archive subcommand supplies the LLVM archiver without an installed SDK.
file(TO_NATIVE_PATH "${SEVK_ZIG_EXECUTABLE}" zig_native)
file(WRITE "${CMAKE_BINARY_DIR}/zig-ar.cmd" "@\"${zig_native}\" ar %*\r\n")
set(CMAKE_AR "${CMAKE_BINARY_DIR}/zig-ar.cmd")
set(CMAKE_C_ARCHIVE_FINISH "")
set(CMAKE_CXX_ARCHIVE_FINISH "")
