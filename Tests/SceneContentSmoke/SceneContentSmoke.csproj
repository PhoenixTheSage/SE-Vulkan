    <Reference Include="SixLabors.Core"><HintPath>$(Bin64Dir)SixLabors.Core.dll</HintPath></Reference>
    <Reference Include="Sandbox.RenderDirect"><HintPath>$(Bin64Dir)Sandbox.RenderDirect.dll</HintPath></Reference>
  </ItemGroup>
</Project>
