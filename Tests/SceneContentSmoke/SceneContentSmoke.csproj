<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems><Nullable>disable</Nullable><LangVersion>latest</LangVersion></PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="RecordingBackend.cs" />
    <Compile Include="../../ClientPlugin/Rendering/Interop/NativeVertexTypes.cs" />
    <Compile Include="../../ClientPlugin/Rendering/WorldConstants.cs" />
    <Compile Include="../../ClientPlugin/Rendering/Shaders/ReflectedConstantBuffer.cs" />
    <Compile Include="../../ClientPlugin/Rendering/Shaders/ShaderMetadata.cs" />
    <Compile Include="../../ClientPlugin/Rendering/Scene/*.cs" Link="Production/%(Filename)%(Extension)" />
