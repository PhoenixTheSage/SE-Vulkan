    <Reference Include="VRage.Math"><HintPath>$(Bin64Dir)VRage.Math.dll</HintPath></Reference>
    <Reference Include="VRage.Render"><HintPath>$(Bin64Dir)VRage.Render.dll</HintPath></Reference>
    <Reference Include="VRage.Render11"><HintPath>$(Bin64Dir)VRage.Render11.dll</HintPath></Reference>
